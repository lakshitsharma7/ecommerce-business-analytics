{
  "name": "ApexCart Executive Dark Glassmorphism",
  "dataColors": [
    "#38BDF8",
    "#10B981",
    "#F59E0B",
    "#F43F5E",
    "#8B5CF6",
    "#EC4899",
    "#06B6D4",
    "#84CC16"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#38BDF8",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1E293B" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#334155" } },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "alignment": "left"
          }
        ],
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "color": { "solid": { "color": "#94A3B8" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#94A3B8" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  }
}
